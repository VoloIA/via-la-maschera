{
  "expo": {
    "name": "Via la Maschera",
    "slug": "via-la-maschera",
    "description": "Un rituale quotidiano di domande personali, risposte sigillate e riflessioni da rileggere con calma.",
    "version": "1.0.0",
    "orientation": "portrait",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "icon": "./assets/images/icon.png",
    "locales": {
      "en": "./locales/en.json",
      "es": "./locales/es.json",
      "it": "./locales/it.json",
      "ru": "./locales/ru.json",
      "uk": "./locales/uk.json"
    },
    "scheme": "vialamaschera",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "bundleIdentifier": "com.vialamaschera.app",
      "buildNumber": "1",
      "supportsTablet": true
    },
    "android": {
      "package": "com.vialamaschera.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#251433",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#251433",
          "dark": {
            "backgroundColor": "#160D22"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ed628ab9-d18b-411b-b32e-c20bf7416759"
      }
    }
  }
}
